/* GBAdhoc XMB: the icon (drawn by mkicon.py), the manifest, the version. */
#include <winver.h>

1 ICON "build/app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,1
PRODUCTVERSION 0,1,0,1
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "The GBAdhoc project"
      VALUE "FileDescription", "GBAdhoc XMB"
      VALUE "FileVersion", "0.1.0-beta.1"
      VALUE "ProductName", "GBAdhoc XMB"
      VALUE "ProductVersion", "0.1.0-beta.1"
      VALUE "OriginalFilename", "GBAdhoc-XMB.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
